# Copy this file to .dev.vars and replace every placeholder with local values.
# Add AI_BASE_URL and AI_MODEL directly to .dev.vars; they are intentionally absent here.
# Never commit .dev.vars.
TELEGRAM_BOT_TOKEN=1234567890:replace-with-your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
AI_API_KEY=replace-with-your-ai-provider-api-key

AI_TIMEOUT_MS=20000
APP_ENV=development
